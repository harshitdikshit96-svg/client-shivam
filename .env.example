# --- app mode ---
# final (default) = the client's frozen spec, no customize layer.  prototype = old field-selection tool.
# NEXT_PUBLIC_APP_MODE=prototype

# --- database ---
# Production / VPS: a PostgreSQL connection string.
# DATABASE_URL=postgres://client_shivam:password@localhost:5432/client_shivam
# Local development without a server: leave unset (uses embedded PGlite in .data/pglite)
# Neon: DATABASE_URL = the pooled address (host has "-pooler"); DATABASE_URL_UNPOOLED = the direct one, used by db:migrate.
# DATABASE_URL_UNPOOLED=postgres://…
# A production server refuses to start on the embedded database unless ALLOW_PGLITE=true (only the e2e tests set it).

# --- single login (used by `npm run db:seed` / `npm run db:login`) ---
# ADMIN_USERNAME=owner
# ADMIN_PASSWORD=change-this-long-password
# On a plain-HTTP server (no HTTPS) the login cookie must not be Secure:
# COOKIE_SECURE=false
# Behind nginx / a load balancer that sets X-Forwarded-For (makes the wrong-password limit per client):
# TRUST_PROXY=true

# --- prototype mode only ---
CLIENT_TOKEN=change-me-client
ADMIN_TOKEN=change-me-admin
# BLOB_READ_WRITE_TOKEN=
